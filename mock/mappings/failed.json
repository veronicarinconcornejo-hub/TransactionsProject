{
  "request": {
    "method": "POST",
    "url": "/provider/v1/execute",
    "headers": {
      "X-API-KEY": {
        "equalTo": "dev-provider-key"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.accountId == 'acc-fallo')]"
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "ERROR",
      "code": "PROVIDER_DOWN",
      "message": "Proveedor temporalmente no disponible"
    }
  }
}